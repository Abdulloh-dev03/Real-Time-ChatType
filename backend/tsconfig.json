{
  "compilerOptions": {
    /* Projects and Modules */
    "target": "ESNext",
    "module": "NodeNext",                  // Required for "type": "module" in package.json
    "moduleResolution": "NodeNext",
    "rootDir": "./",                    // Where your source code lives
    "outDir": "./dist",                    // Where the compiled JS will go
    
    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    
    /* Interop and Environment */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "lib": ["ESNext"],
    
    /* Output settings */
    "sourceMap": true,
    "declaration": true,
    "verbatimModuleSyntax": true
  }
}